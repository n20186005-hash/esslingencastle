# Deployment domain – single source of truth for canonical URLs, hreflang,
# Open Graph metadata, sitemap.xml and robots.txt.
#
# Read at build time (static export). For multi-site deployments, set a
# different value per build, e.g.:
#   NEXT_PUBLIC_CURRENT_SITE_DOMAIN=example.com npm run build
NEXT_PUBLIC_CURRENT_SITE_DOMAIN=esslingencastle.com
